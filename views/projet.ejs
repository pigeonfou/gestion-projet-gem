<%- include('partials/header') %>

<div class="dash-wrap">
  <!-- En-tête Projet -->
  <div class="page-header" style="align-items:flex-start;">
    <div>
      <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;">
        <h1 style="margin:0;"><i class="fas fa-microchip" style="color:var(--primary);"></i> <%= projet.nom %></h1>
        <span class="badge-role" style="background:#eef2ff;color:#4f46e5;font-size:0.8rem;padding:0.3rem 0.75rem;font-weight:700;">
          Étape <%= currentStep %>/9 &bull; <%= steps[currentStep] ? steps[currentStep].title : '' %>
        </span>
        <% if (projet.go_decision === 'NO_GO') { %>
          <span class="badge-role" style="background:#fef2f2;color:#b91c1c;font-size:0.8rem;padding:0.3rem 0.75rem;font-weight:700;">
            <i class="fas fa-times-circle"></i> Décision NO GO
          </span>
        <% } else if (projet.status === 'termine') { %>
          <span class="badge-role" style="background:#ecfdf5;color:#047857;font-size:0.8rem;padding:0.3rem 0.75rem;font-weight:700;">
            <i class="fas fa-check-circle"></i> Validé DG &bull; Vente
          </span>
        <% } %>
      </div>
      <p class="subtitle">
        Initié par <strong><%= createur ? createur.nom_affiche || createur.identifiant : 'Admin' %></strong> le <%= projet.date_creation.split(' ')[0] %>
        <% if (projet.description) { %> &mdash; <%= projet.description %><% } %>
      </p>
    </div>
    <div style="display:flex;gap:.5rem;">
      <a href="/projets/modifier?id=<%= projet.id %><%= qAmp %>" class="btn btn-secondary btn-sm"><i class="fas fa-edit"></i> Modifier</a>
      <a href="/projets<%= qs %>" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Tous les projets</a>
    </div>
  </div>

  <!-- Navigation par Onglets Modernes -->
  <div style="display:flex;gap:0.5rem;margin-bottom:1.5rem;background:#ffffff;padding:0.4rem;border-radius:var(--radius-lg);border:1px solid var(--border);box-shadow:var(--shadow-xs);width:fit-content;">
    <a href="/projet?id=<%= projet.id %>&view=processus<%= qAmp %>" class="btn btn-sm <%= view === 'processus' ? 'btn-primary' : 'btn-secondary' %>" style="border:none;">
      <i class="fas fa-sitemap"></i> Processus R1b (9 Étapes)
    </a>
    <a href="/projet?id=<%= projet.id %>&view=taches<%= qAmp %>" class="btn btn-sm <%= view === 'taches' ? 'btn-primary' : 'btn-secondary' %>" style="border:none;">
      <i class="fas fa-tasks"></i> Tâches associées (<%= tasks.length %>)
    </a>
    <a href="/projet?id=<%= projet.id %>&view=cahier<%= qAmp %>" class="btn btn-sm <%= view === 'cahier' ? 'btn-primary' : 'btn-secondary' %>" style="border:none;">
      <i class="fas fa-file-contract"></i> Cahier des charges
    </a>
  </div>

  <% if (view === 'processus') { %>
    <!-- Stepper Horizontal Interactif R1b -->
    <div class="r1b-stepper-wrap">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;">
        <h3 style="font-size:1.05rem;font-weight:700;color:var(--text-main);margin:0;">
          <i class="fas fa-route" style="color:var(--primary);margin-right:0.4rem;"></i>
          Cycle de développement R&amp;D (Norme R1b)
        </h3>
        <span style="font-size:0.8rem;color:var(--text-muted);font-weight:600;">
          Cliquez sur une étape pour consulter ses détails
        </span>
      </div>

      <div class="r1b-stepper">
        <% for (let i = 1; i <= 9; i++) { 
             const st = steps[i];
             const isCurrent = i === currentStep;
             const isDone = projet.validated_steps.includes(i) || i < projet.current_step;
        %>
          <a href="/projet?id=<%= projet.id %>&view=processus&step=<%= i %><%= qAmp %>" class="r1b-step <%= isCurrent ? 'active' : '' %> <%= isDone ? 'done' : '' %>">
            <div class="r1b-step-circle">
              <% if (isDone) { %>
                <i class="fas fa-check" style="font-size:0.9rem;"></i>
              <% } else { %>
                <%= i %>
              <% } %>
            </div>
            <div class="r1b-step-label"><%= st.title %></div>
          </a>
          <% if (i < 9) { %>
            <div class="r1b-step-line <%= (projet.validated_steps.includes(i) || i < projet.current_step) ? 'on' : '' %>"></div>
          <% } %>
        <% } %>
      </div>
    </div>

    <!-- Détail de l'étape active -->
    <div class="card" style="padding:1.75rem;">
      <div style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border);padding-bottom:1.25rem;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;">
        <div>
          <span style="font-size:0.75rem;text-transform:uppercase;color:var(--primary);font-weight:700;letter-spacing:0.06em;">
            Étape courante &bull; <%= currentStep %> sur 9
          </span>
          <h2 style="font-size:1.4rem;font-weight:800;margin:0.25rem 0 0;color:var(--text-main);letter-spacing:-0.02em;">
            <%= steps[currentStep] ? steps[currentStep].title : '' %>
          </h2>
        </div>
        <div style="display:flex;gap:0.5rem;">
          <% if (currentStep > 1) { %>
            <a href="/projet?id=<%= projet.id %>&view=processus&step=<%= currentStep - 1 %><%= qAmp %>" class="btn btn-secondary btn-sm">
              <i class="fas fa-chevron-left"></i> Précédente
            </a>
          <% } %>
          <% if (currentStep < 9) { %>
            <a href="/projet?id=<%= projet.id %>&view=processus&step=<%= currentStep + 1 %><%= qAmp %>" class="btn btn-secondary btn-sm">
              Suivante <i class="fas fa-chevron-right"></i>
            </a>
          <% } %>
        </div>
      </div>

      <% if (currentStep === 1) { %>
        <!-- Étape 1 : Cadrage & Besoin -->
        <div style="background:var(--bg-subtle);border:1px solid var(--border);border-radius:var(--radius-md);padding:1.25rem;margin-bottom:1.5rem;">
          <h4 style="margin:0 0 0.75rem;font-size:0.95rem;color:var(--text-main);font-weight:700;">
            <i class="fas fa-info-circle" style="color:var(--primary);"></i> Note de cadrage initial
          </h4>
          <p style="font-size:0.875rem;color:var(--text-body);margin:0 0 0.4rem;">
            Origine de l'entrée : <strong><%= projet.cadrage_commerciale ? 'Service Commercial' : '' %><%= projet.cadrage_commerciale && projet.cadrage_technique ? ' & ' : '' %><%= projet.cadrage_technique ? 'Service Technique' : '' %><%= (!projet.cadrage_commerciale && !projet.cadrage_technique) ? 'Direction R&D' : '' %></strong>
          </p>
          <p style="font-size:0.875rem;color:var(--text-body);margin:0;">
            Destination du livrable : <strong><%= projet.cadrage_destination === 'externe' ? 'Projet Externe (Client final)' : 'Projet Interne (Outil R&D labo)' %></strong>
          </p>
        </div>
      <% } else if (currentStep === 3) { %>
        <!-- Étape 3 : Jalon décisionnel GO / NO GO -->
        <div style="background:<%= projet.go_decision === 'NO_GO' ? 'var(--danger-bg)' : 'var(--success-bg)' %>;border:1px solid <%= projet.go_decision === 'NO_GO' ? 'var(--danger-border)' : 'var(--success-border)' %>;border-radius:var(--radius-md);padding:1.5rem;margin-bottom:1.5rem;">
          <h4 style="margin:0 0 0.5rem;color:<%= projet.go_decision === 'NO_GO' ? 'var(--danger-text)' : 'var(--success-text)' %>;font-weight:700;">
            <i class="fas fa-gavel"></i> Arbitrage Direction Générale (Jalon GO / NO GO)
          </h4>
          <p style="font-size:0.875rem;color:var(--text-body);margin:0 0 1.25rem;">
            Statut actuel de la décision : <strong><%= projet.go_decision ? (projet.go_decision === 'NO_GO' ? 'Refusé (NO GO)' : 'Validé (GO)') : 'En attente d’arbitrage' %></strong>
          </p>
          <form method="POST" action="/projet/decision" style="display:flex;gap:0.75rem;">
            <% if (locals.sid) { %><input type="hidden" name="sid" value="<%= locals.sid %>"><% } %>
            <input type="hidden" name="id" value="<%= projet.id %>">
            <input type="hidden" name="step" value="3">
            <button type="submit" name="decision" value="GO" class="btn btn-primary btn-sm" style="background:#10b981;border-color:#059669;">
              <i class="fas fa-check"></i> Prononcer la décision GO
            </button>
            <button type="submit" name="decision" value="NO_GO" class="btn btn-danger btn-sm">
              <i class="fas fa-times"></i> Prononcer la décision NO GO
            </button>
          </form>
        </div>
      <% } %>

      <!-- Formulaire de Notes & Validation d'Étape -->
      <form method="POST" action="/projet/notes">
        <% if (locals.sid) { %><input type="hidden" name="sid" value="<%= locals.sid %>"><% } %>
        <input type="hidden" name="id" value="<%= projet.id %>">
        <input type="hidden" name="step" value="<%= currentStep %>">

        <div class="form-group">
          <label for="step_notes" style="font-weight:700;color:var(--text-main);">
            Livrables, relevés techniques &amp; observations (Étape <%= currentStep %>)
          </label>
          <textarea id="step_notes" name="step_notes" class="form-control" rows="4" placeholder="Compte-rendu d'étape, conclusions techniques, mesures..."><%= projet.step_notes || '' %></textarea>
        </div>

        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--border-light);">
          <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Enregistrer les notes</button>
      </form>

          <form method="POST" action="/projet/valider_etape" style="display:inline;">
            <% if (locals.sid) { %><input type="hidden" name="sid" value="<%= locals.sid %>"><% } %>
            <input type="hidden" name="id" value="<%= projet.id %>">
            <input type="hidden" name="step" value="<%= currentStep %>">
            <button type="submit" class="btn btn-secondary" style="background:#ecfdf5;color:#047857;border-color:#a7f3d0;font-weight:600;">
              <i class="fas fa-check-double"></i> Valider et passer à l'étape suivante
            </button>
          </form>
        </div>
    </div>

  <% } else if (view === 'taches') { %>
    <!-- Tâches liées au projet -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
      <h3 style="margin:0;font-size:1.15rem;font-weight:700;color:var(--text-main);">
        <i class="fas fa-tasks" style="color:var(--primary);margin-right:0.4rem;"></i>
        Tâches spécifiques à <%= projet.nom %>
      </h3>
      <a href="/tache/creer?projet_id=<%= projet.id %><%= qAmp %>" class="btn btn-primary btn-sm">
        <i class="fas fa-plus"></i> Nouvelle tâche
      </a>
    </div>

    <div class="r1b-kanban r1b-kanban-4">
      <% const kanbanCols = [
           { id: 'a_faire', title: 'À faire', bg: 'kanban-col-todo' },
           { id: 'en_cours', title: 'En cours', bg: 'kanban-col-progress' },
           { id: 'validation', title: 'En validation', bg: 'kanban-col-validation' },
           { id: 'terminee', title: 'Terminé', bg: 'kanban-col-done' }
         ];
      %>
      <% kanbanCols.forEach(col => { 
           const items = tasks.filter(t => t.kanban_status === col.id);
      %>
        <div class="r1b-kanban-col <%= col.bg %>">
          <div class="r1b-kanban-head">
            <span class="kanban-col-title"><%= col.title %></span>
            <span class="kanban-col-count"><%= items.length %></span>
          </div>
          <% if (items.length === 0) { %>
            <p class="text-muted" style="padding:.5rem .25rem;font-size:0.8rem;">Aucune tâche</p>
          <% } %>
          <% items.forEach(t => { %>
            <div class="r1b-kanban-card">
              <p class="font-medium"><a href="/tache/modifier?id=<%= t.id %><%= qAmp %>"><%= t.titre %></a></p>
              <% if (t.description) { %>
                <p style="font-size:0.75rem;color:var(--text-muted);margin-top:0.4rem;line-height:1.4;"><%= t.description.slice(0, 110) %></p>
              <% } %>
              <div class="task-card-meta">
                <span class="badge-role" style="font-size:0.65rem;">#<%= t.id %></span>
                <span class="badge-role" style="font-size:0.65rem;background:<%= t.priorite === 'urgente' ? '#fee2e2;color:#b91c1c' : (t.priorite === 'haute' ? '#fffbeb;color:#b45309' : '#f1f5f9;color:#475569') %>;">
                  <%= t.priorite %>
                </span>
                <% if (t.date_echeance) { %>
                  <span style="font-size:0.7rem;"><i class="fas fa-calendar-alt"></i> <%= t.date_echeance %></span>
                <% } %>
              </div>
              <div class="kanban-card-foot">
                <div class="kanban-assignee">
                  <span class="user-avatar-circle" style="width:22px;height:22px;font-size:0.65rem;">
                    <%= t.assigne_a ? t.assigne_a.charAt(0).toUpperCase() : '?' %>
                  </span>
                  <span><%= t.assigne_a || 'Non assigné' %></span>
                </div>
                <form method="POST" action="/taches/update_status" class="kanban-status-form">
                  <% if (locals.sid) { %><input type="hidden" name="sid" value="<%= locals.sid %>"><% } %>
                  <input type="hidden" name="task_id" value="<%= t.id %>">
                  <input type="hidden" name="projet_id" value="<%= projet.id %>">
                  <select name="status" class="kanban-status-select" onchange="this.form.submit()">
                    <option value="a_faire" <%= t.kanban_status === 'a_faire' ? 'selected' : '' %>>À faire</option>
                    <option value="en_cours" <%= t.kanban_status === 'en_cours' ? 'selected' : '' %>>En cours</option>
                    <option value="validation" <%= t.kanban_status === 'validation' ? 'selected' : '' %>>Validation</option>
                    <option value="terminee" <%= t.kanban_status === 'terminee' ? 'selected' : '' %>>Terminé</option>
                  </select>
                </form>
              </div>
            </div>
          <% }); %>
        </div>
      <% }); %>
    </div>

  <% } else if (view === 'cahier') { %>
    <!-- Cahier des charges -->
    <div class="card" style="padding:1.75rem;">
      <h3 style="margin:0 0 1.5rem;font-size:1.2rem;font-weight:800;color:var(--text-main);">
        <i class="fas fa-file-contract" style="color:var(--primary);margin-right:0.4rem;"></i>
        Cahier des charges fonctionnel &amp; technique
      </h3>
      
      <form method="POST" action="/projet/cahier">
        <% if (locals.sid) { %><input type="hidden" name="sid" value="<%= locals.sid %>"><% } %>
        <input type="hidden" name="id" value="<%= projet.id %>">
        
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">
          <div class="form-group">
            <label for="categorie">Catégorie de produit</label>
            <input type="text" id="categorie" name="categorie" class="form-control" value="<%= cahier.categorie || '' %>" placeholder="Ex: Produit Électronique Connecté">
          </div>
          <div class="form-group">
            <label for="budget">Budget alloué HT</label>
            <input type="text" id="budget" name="budget" class="form-control" value="<%= cahier.budget || '' %>" placeholder="Ex: 25 000 € HT">
          </div>
        </div>

        <div class="form-group">
          <label for="contexte">Contexte &amp; genèse du besoin</label>
          <textarea id="contexte" name="contexte" class="form-control" rows="3" placeholder="Pourquoi ce projet est-il lancé ? Quel est l'environnement client ?"><%= cahier.contexte || '' %></textarea>
        </div>

        <div class="form-group">
          <label for="objectifs">Objectifs mesurables</label>
          <textarea id="objectifs" name="objectifs" class="form-control" rows="3" placeholder="Quels résultats clés doivent être atteints ?"><%= cahier.objectifs || '' %></textarea>
        </div>

        <div class="form-group">
          <label for="contraintes">Contraintes techniques, normatives &amp; industrielles</label>
          <textarea id="contraintes" name="contraintes" class="form-control" rows="3" placeholder="Normes CE, CEM, encombrement maximal, autonomie batterie..."><%= cahier.contraintes || '' %></textarea>
        </div>

        <div class="form-group">
          <label for="criteres_reussite">Critères d'acceptation &amp; de recette</label>
          <textarea id="criteres_reussite" name="criteres_reussite" class="form-control" rows="3" placeholder="Critères validant le passage en production de série"><%= cahier.criteres_reussite || '' %></textarea>
        </div>

        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Enregistrer le cahier des charges</button>
      </form>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
