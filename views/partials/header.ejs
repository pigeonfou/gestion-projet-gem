<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle ? pageTitle + ' - ' : '' %><%= siteNom %></title>
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="stylesheet" href="/assets/css/projet-r1b.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <% const qs = locals.sid ? '?sid=' + encodeURIComponent(locals.sid) : ''; %>
  <% const qAmp = locals.sid ? '&sid=' + encodeURIComponent(locals.sid) : ''; %>
  <header class="header">
    <div class="header-container">
      <a href="/projets<%= qs %>" class="logo">
        <i class="fas fa-project-diagram"></i>
        <span><%= siteNom %></span>
        <span class="logo-badge">R&amp;D</span>
      </a>
      <% if (user) { %>
      <nav class="nav">
        <a href="/projets<%= qs %>" class="nav-link <%= activePage === 'projets' ? 'active' : '' %>">
          <i class="fas fa-folder-open"></i> Projets
        </a>
        <a href="/taches<%= qs %>" class="nav-link <%= activePage === 'taches' ? 'active' : '' %>">
          <i class="fas fa-tasks"></i> Tâches
        </a>
        <a href="/stocks<%= qs %>" class="nav-link <%= activePage === 'stocks' ? 'active' : '' %>">
          <i class="fas fa-boxes"></i> Stocks &amp; Matériel
        </a>
        <a href="/management<%= qs %>" class="nav-link <%= activePage === 'management' ? 'active' : '' %>">
          <i class="fas fa-sitemap"></i> Management
        </a>
      </nav>
      <div class="user-menu">
        <div class="user-dropdown">
          <button type="button" class="user-dropdown-toggle" id="userMenuBtn" aria-expanded="false">
            <span class="user-avatar-circle"><%= user.identifiant.charAt(0).toUpperCase() %></span>
            <span><%= user.identifiant %></span>
            <span class="badge-role"><%= user.role %></span>
            <i class="fas fa-chevron-down" style="font-size:0.7rem;opacity:0.6;margin-left:0.2rem;"></i>
          </button>
          <div class="user-dropdown-menu" id="userMenu">
            <% if (user.role === 'admin') { %>
            <a href="/admin/settings<%= qs %>"><i class="fas fa-cog"></i> Paramètres généraux</a>
            <a href="/admin/utilisateurs<%= qs %>"><i class="fas fa-users"></i> Gestion utilisateurs</a>
            <div class="dropdown-divider"></div>
            <% } %>
            <a href="/logout<%= qs %>" style="color:#ef4444;"><i class="fas fa-sign-out-alt"></i> Déconnexion</a>
          </div>
        </div>
      </div>
      <% } %>
    </div>
  </header>

  <main class="main-content">
    <% if (flash && flash.message) { %>
    <div class="dash-wrap" style="padding-top:1.5rem;padding-bottom:0;">
      <div class="alert alert-<%= flash.type || 'info' %>">
        <i class="fas fa-<%= flash.type === 'success' ? 'check-circle' : (flash.type === 'error' ? 'exclamation-circle' : 'info-circle') %>"></i>
        <span><%= flash.message %></span>
        <button class="alert-close" onclick="this.parentElement.remove()">&times;</button>
      </div>
    </div>
    <% } %>
