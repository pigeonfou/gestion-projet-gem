<%- include('partials/header') %>

<div class="dash-wrap">
  <div class="page-header">
    <div>
      <h1><i class="fas fa-boxes" style="color:var(--primary);"></i> Stocks &amp; Matériel R&amp;D</h1>
      <p class="subtitle">Catalogue des composants électroniques, matières premières et outillages de laboratoire</p>
    </div>
    <div style="display:flex;gap:.5rem;">
      <a href="/stock/creer<%= qs %>" class="btn btn-primary">
        <i class="fas fa-plus"></i> Nouvel article
      </a>
    </div>
  </div>

  <!-- KPI Grid -->
  <div class="dash-kpi-grid">
    <div class="dash-kpi">
      <div class="dash-kpi-header">
        <span class="dash-kpi-label">Total références</span>
        <div class="dash-kpi-icon indigo"><i class="fas fa-barcode"></i></div>
      </div>
      <div class="dash-kpi-value"><%= kpis.total %></div>
    </div>

    <div class="dash-kpi">
      <div class="dash-kpi-header">
        <span class="dash-kpi-label">Pièces &amp; Composants</span>
        <div class="dash-kpi-icon blue"><i class="fas fa-microchip"></i></div>
      </div>
      <div class="dash-kpi-value"><%= kpis.pieces %></div>
    </div>

    <div class="dash-kpi">
      <div class="dash-kpi-header">
        <span class="dash-kpi-label">Équipements labo</span>
        <div class="dash-kpi-icon emerald"><i class="fas fa-tools"></i></div>
      </div>
      <div class="dash-kpi-value"><%= kpis.equipements %></div>
    </div>

    <div class="dash-kpi">
      <div class="dash-kpi-header">
        <span class="dash-kpi-label">Alertes réappro.</span>
        <div class="dash-kpi-icon amber"><i class="fas fa-exclamation-triangle"></i></div>
      </div>
      <div class="dash-kpi-value" style="<%= kpis.alertes > 0 ? 'color:var(--danger);' : '' %>"><%= kpis.alertes %></div>
    </div>
  </div>

  <!-- Barre de recherche & Filtres -->
  <div class="card" style="padding:1.25rem;margin-bottom:1.5rem;">
    <form method="GET" action="/stocks" style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap;">
      <% if (locals.sid) { %><input type="hidden" name="sid" value="<%= locals.sid %>"><% } %>
      <div style="flex:1;min-width:260px;">
        <input type="text" name="q" class="form-control" placeholder="Rechercher par référence, désignation, emplacement..." value="<%= q || '' %>">
      </div>
      <div>
        <select name="type" class="form-control" onchange="this.form.submit()" style="font-weight:500;">
          <option value="">Tous les types d'articles</option>
          <option value="piece" <%= typeFilter === 'piece' ? 'selected' : '' %>>Composants &amp; Pièces</option>
          <option value="equipement" <%= typeFilter === 'equipement' ? 'selected' : '' %>>Équipements &amp; Outillage</option>
        </select>
      </div>
      <div style="display:flex;align-items:center;gap:0.5rem;background:var(--bg-subtle);padding:0.45rem 0.85rem;border-radius:var(--radius-md);border:1px solid var(--border);">
        <input type="checkbox" id="alerte" name="alerte" value="1" <%= alertOnly ? 'checked' : '' %> onchange="this.form.submit()" style="cursor:pointer;">
        <label for="alerte" style="font-size:0.825rem;margin:0;cursor:pointer;font-weight:600;color:var(--text-body);">
          Alertes de réapprovisionnement uniquement
        </label>
      </div>
      <button type="submit" class="btn btn-secondary btn-sm"><i class="fas fa-search"></i> Filtrer</button>
      <% if (q || typeFilter || alertOnly) { %>
        <a href="/stocks<%= qs %>" class="btn btn-secondary btn-sm">Réinitialiser</a>
      <% } %>
    </form>
  </div>

  <!-- Tableau Catalogue & Niveaux de Stock -->
  <div class="card" style="overflow-x:auto;">
    <table class="table">
      <thead>
        <tr>
          <th>Référence</th>
          <th>Désignation &amp; Caractéristiques</th>
          <th>Type</th>
          <th>Emplacement Labo</th>
          <th>Fournisseur</th>
          <th style="text-align:right;">Stock dispo</th>
          <th style="text-align:right;">Seuil min</th>
          <th style="text-align:right;">P.U. HT</th>
          <th style="text-align:center;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (articles.length === 0) { %>
          <tr>
            <td colspan="9" style="text-align:center;padding:3rem 1.5rem;color:var(--text-muted);">
              <i class="fas fa-boxes" style="font-size:2rem;opacity:0.3;margin-bottom:0.5rem;display:block;"></i>
              Aucun article correspondant dans le catalogue de stock.
            </td>
          </tr>
        <% } %>
        <% articles.forEach(a => { 
             const isAlert = a.quantite_stock <= a.quantite_min;
        %>
          <tr>
            <td style="font-weight:700;font-family:'JetBrains Mono',monospace;color:var(--text-main);font-size:0.825rem;">
              <span class="badge-role" style="background:#f1f5f9;color:#0f172a;border:1px solid #e2e8f0;"><%= a.reference %></span>
            </td>
            <td>
              <div style="font-weight:600;color:var(--text-main);"><%= a.designation %></div>
              <% if (a.description) { %>
                <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.2rem;"><%= a.description.length > 70 ? a.description.slice(0, 70) + '…' : a.description %></div>
              <% } %>
            </td>
            <td>
              <span class="badge-role" style="font-size:0.7rem;font-weight:700;<%= a.type === 'equipement' ? 'background:#ede9fe;color:#5b21b6;' : 'background:#e0f2fe;color:#0369a1;' %>">
                <%= a.type === 'equipement' ? 'Équipement' : 'Pièce' %>
              </span>
            </td>
            <td>
              <span style="display:inline-flex;align-items:center;gap:0.35rem;font-size:0.8rem;color:var(--text-body);">
                <i class="fas fa-map-marker-alt" style="color:var(--primary);font-size:0.75rem;"></i>
                <%= a.emplacement || 'Non renseigné' %>
              </span>
            </td>
            <td style="color:var(--text-body);font-size:0.85rem;"><%= a.fournisseur || '—' %></td>
            <td style="text-align:right;font-weight:800;font-size:0.925rem;color:<%= isAlert ? '#ef4444' : 'var(--text-main)' %>;">
              <%= a.quantite_stock %> <span style="font-size:0.75rem;font-weight:500;color:var(--text-muted);"><%= a.unite %></span>
              <% if (isAlert) { %>
                <i class="fas fa-exclamation-circle" title="Alerte : stock critique ou épuisé !" style="margin-left:0.3rem;color:#ef4444;"></i>
              <% } %>
            </td>
            <td style="text-align:right;color:var(--text-muted);font-size:0.85rem;"><%= a.quantite_min %> <%= a.unite %></td>
            <td style="text-align:right;font-family:'JetBrains Mono',monospace;font-weight:600;"><%= a.valeur_unitaire.toFixed(2) %> €</td>
            <td style="text-align:center;">
              <div style="display:inline-flex;gap:0.35rem;">
                <a href="/stock/modifier?id=<%= a.id %><%= qAmp %>" class="btn btn-secondary btn-sm" title="Modifier">
                  <i class="fas fa-edit"></i>
                </a>
                <form method="POST" action="/stock/supprimer" style="display:inline;" onsubmit="return confirm('Confirmer la suppression de cet article ?');">
                  <% if (locals.sid) { %><input type="hidden" name="sid" value="<%= locals.sid %>"><% } %>
                  <input type="hidden" name="id" value="<%= a.id %>">
                  <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
