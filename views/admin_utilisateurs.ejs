<%- include('partials/header') %>

<div class="dash-wrap">
  <div class="page-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
    <div>
      <h1><i class="fas fa-users"></i> Gestion des utilisateurs</h1>
      <p class="text-muted text-sm mt-1">Comptes, rôles d'accès et compétences techniques des collaborateurs</p>
    </div>
    <div style="display:flex;gap:.5rem;">
      <a href="/admin/utilisateurs/creer" class="btn btn-primary"><i class="fas fa-user-plus"></i> Nouvel utilisateur</a>
    </div>
  </div>

  <div class="card" style="overflow-x:auto;">
    <table class="table" style="width:100%;border-collapse:collapse;font-size:0.875rem;">
      <thead>
        <tr style="background:#f8fafc;border-bottom:2px solid #e2e8f0;text-align:left;">
          <th style="padding:.75rem 1rem;">Identifiant</th>
          <th style="padding:.75rem 1rem;">Nom affiché</th>
          <th style="padding:.75rem 1rem;">Rôle</th>
          <th style="padding:.75rem 1rem;">Fonction</th>
          <th style="padding:.75rem 1rem;">Compétences</th>
          <th style="padding:.75rem 1rem;text-align:center;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% usersList.forEach(u => { %>
          <tr style="border-bottom:1px solid #f1f5f9;">
            <td style="padding:.75rem 1rem;font-weight:700;color:#0f172a;"><%= u.identifiant %></td>
            <td style="padding:.75rem 1rem;"><%= u.nom_affiche || '—' %></td>
            <td style="padding:.75rem 1rem;">
              <span class="badge-role" style="background:<%= u.role === 'admin' ? '#7c3aed;color:#fff' : '#e2e8f0;color:#334155' %>;">
                <%= u.role %>
              </span>
            </td>
            <td style="padding:.75rem 1rem;color:#475569;"><%= u.fonction || '—' %></td>
            <td style="padding:.75rem 1rem;color:#64748b;font-size:0.8rem;"><%= u.competences || '—' %></td>
            <td style="padding:.75rem 1rem;text-align:center;">
              <a href="/admin/utilisateurs/modifier?id=<%= u.id %>" class="btn btn-secondary btn-sm"><i class="fas fa-edit"></i></a>
              <% if (u.identifiant !== 'admin') { %>
                <form method="POST" action="/admin/utilisateurs/supprimer" style="display:inline;" onsubmit="return confirm('Supprimer cet utilisateur ?');">
                  <input type="hidden" name="id" value="<%= u.id %>">
                  <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
