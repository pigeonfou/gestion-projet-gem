<%- include('partials/header') %>

<div class="dash-wrap">
  <div class="page-header">
    <div>
      <h1><i class="fas fa-users" style="color:var(--primary);"></i> Gestion des Utilisateurs</h1>
      <p class="subtitle">Comptes d'accès, habilitations, fonctions et compétences professionnelles</p>
    </div>
    <div style="display:flex;gap:.5rem;">
      <a href="/admin/utilisateurs/creer<%= qs %>" class="btn btn-primary">
        <i class="fas fa-user-plus"></i> Nouvel utilisateur
      </a>
    </div>
  </div>

  <div class="card" style="overflow-x:auto;">
    <table class="table">
      <thead>
        <tr>
          <th>Identifiant</th>
          <th>Nom &amp; Prénom</th>
          <th>Rôle système</th>
          <th>Fonction / Titre</th>
          <th>Compétences clés</th>
          <th style="text-align:center;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% usersList.forEach(u => { %>
          <tr>
            <td style="font-weight:700;color:var(--text-main);">
              <div style="display:flex;align-items:center;gap:0.5rem;">
                <span class="user-avatar-circle"><%= u.identifiant.charAt(0).toUpperCase() %></span>
                <span><%= u.identifiant %></span>
              </div>
            </td>
            <td style="font-weight:600;"><%= u.nom_affiche || '—' %></td>
            <td>
              <span class="badge-role" style="<%= u.role === 'admin' ? 'background:#ede9fe;color:#5b21b6;' : 'background:#f1f5f9;color:#475569;' %>font-weight:700;">
                <%= u.role === 'admin' ? 'Administrateur' : 'Utilisateur' %>
              </span>
            </td>
            <td style="color:var(--text-body);"><%= u.fonction || '—' %></td>
            <td style="color:var(--text-muted);font-size:0.8rem;"><%= u.competences || '—' %></td>
            <td style="text-align:center;">
              <div style="display:inline-flex;gap:0.35rem;">
                <a href="/admin/utilisateurs/modifier?id=<%= u.id %><%= qAmp %>" class="btn btn-secondary btn-sm" title="Modifier">
                  <i class="fas fa-edit"></i>
                </a>
                <% if (u.identifiant !== 'admin') { %>
                  <form method="POST" action="/admin/utilisateurs/supprimer" style="display:inline;" onsubmit="return confirm('Confirmer la suppression de cet utilisateur ?');">
                    <% if (locals.sid) { %><input type="hidden" name="sid" value="<%= locals.sid %>"><% } %>
                    <input type="hidden" name="id" value="<%= u.id %>">
                    <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
                      <i class="fas fa-trash"></i>
                    </button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
