<%- include('partials/header') %>

<div class="dash-wrap">
  <div class="page-header">
    <div>
      <h1><i class="fas fa-sitemap" style="color:var(--primary);"></i> Système de Management &amp; Qualité</h1>
      <p class="subtitle">Référentiel qualité ISO 9001, maîtrise documentaire, gestion des risques et amélioration continue</p>
    </div>
  </div>

  <!-- KPI Grid -->
  <div class="dash-kpi-grid">
    <div class="dash-kpi">
      <div class="dash-kpi-header">
        <span class="dash-kpi-label">Processus actifs</span>
        <div class="dash-kpi-icon indigo"><i class="fas fa-project-diagram"></i></div>
      </div>
      <div class="dash-kpi-value"><%= kpis.processus %></div>
    </div>

    <div class="dash-kpi">
      <div class="dash-kpi-header">
        <span class="dash-kpi-label">Documents maîtrisés</span>
        <div class="dash-kpi-icon blue"><i class="fas fa-file-contract"></i></div>
      </div>
      <div class="dash-kpi-value"><%= kpis.documents %></div>
    </div>

    <div class="dash-kpi">
      <div class="dash-kpi-header">
        <span class="dash-kpi-label">Risques ouverts</span>
        <div class="dash-kpi-icon amber"><i class="fas fa-shield-alt"></i></div>
      </div>
      <div class="dash-kpi-value"><%= kpis.risques %></div>
    </div>

    <div class="dash-kpi">
      <div class="dash-kpi-header">
        <span class="dash-kpi-label">Actions qualité</span>
        <div class="dash-kpi-icon emerald"><i class="fas fa-check-square"></i></div>
      </div>
      <div class="dash-kpi-value"><%= kpis.actions %></div>
    </div>
  </div>

  <!-- Navigation par Onglets Modernes -->
  <div style="display:flex;gap:0.5rem;margin-bottom:1.5rem;background:#ffffff;padding:0.4rem;border-radius:var(--radius-lg);border:1px solid var(--border);box-shadow:var(--shadow-xs);width:fit-content;flex-wrap:wrap;">
    <% const tabs = [
         { id: 'processus', label: 'Cartographie des Processus', icon: 'fa-project-diagram' },
         { id: 'documents', label: 'Documents maîtrisés', icon: 'fa-file-alt' },
         { id: 'risques', label: 'Risques & Opportunités', icon: 'fa-shield-alt' },
         { id: 'actions', label: 'Plan d’actions', icon: 'fa-check-square' },
         { id: 'nc', label: 'Non-conformités', icon: 'fa-exclamation-triangle' }
       ];
    %>
    <% tabs.forEach(t => { %>
      <a class="btn btn-sm <%= currentTab === t.id ? 'btn-primary' : 'btn-secondary' %>" href="/management?tab=<%= t.id %><%= qAmp %>" style="border:none;">
        <i class="fas <%= t.icon %>"></i> <%= t.label %>
      </a>
    <% }); %>
  </div>

  <% if (currentTab === 'processus') { %>
    <div class="card" style="padding:1.5rem;">
      <h2 style="font-size:1.15rem;font-weight:700;margin:0 0 1.25rem;color:var(--text-main);">
        <i class="fas fa-project-diagram" style="color:var(--primary);margin-right:0.4rem;"></i>
        Cartographie &amp; Pilotage des Processus
      </h2>
      <form method="POST" action="/management" style="background:var(--bg-subtle);padding:1.25rem;border-radius:var(--radius-md);margin-bottom:1.5rem;border:1px solid var(--border);">
        <% if (locals.sid) { %><input type="hidden" name="sid" value="<%= locals.sid %>"><% } %>
        <input type="hidden" name="action" value="processus">
        <div style="display:grid;grid-template-columns:130px 1fr 1fr auto;gap:0.75rem;align-items:center;">
          <input class="form-control" name="code" placeholder="Code (PR-xx)" required>
          <input class="form-control" name="nom" placeholder="Nom du processus" required>
          <input class="form-control" name="pilote" placeholder="Pilote du processus">
          <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Ajouter</button>
        </div>
        <textarea class="form-control" name="description" placeholder="Finalité, indicateurs de performance, entrées, sorties..." style="margin-top:.75rem;" rows="2"></textarea>
      </form>

      <table class="table">
        <thead>
          <tr>
            <th>Code</th>
            <th>Processus</th>
            <th>Pilote</th>
            <th>Description &amp; Périmètre</th>
          </tr>
        </thead>
        <tbody>
          <% processusList.forEach(p => { %>
            <tr>
              <td style="font-weight:700;font-family:'JetBrains Mono',monospace;">
                <span class="badge-role" style="background:#eef2ff;color:#4f46e5;"><%= p.code %></span>
              </td>
              <td style="font-weight:700;color:var(--text-main);"><%= p.nom %></td>
              <td style="color:var(--text-body);"><%= p.pilote || '—' %></td>
              <td style="color:var(--text-muted);"><%= p.description %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  <% } else if (currentTab === 'documents') { %>
    <div class="card" style="padding:1.5rem;">
      <h2 style="font-size:1.15rem;font-weight:700;margin:0 0 1.25rem;color:var(--text-main);">
        <i class="fas fa-file-alt" style="color:var(--primary);margin-right:0.4rem;"></i>
        Gestion des Documents Maîtrisés (GED)
      </h2>
      <form method="POST" action="/management" style="background:var(--bg-subtle);padding:1.25rem;border-radius:var(--radius-md);margin-bottom:1.5rem;border:1px solid var(--border);">
        <% if (locals.sid) { %><input type="hidden" name="sid" value="<%= locals.sid %>"><% } %>
        <input type="hidden" name="action" value="document">
        <div style="display:grid;grid-template-columns:150px 1fr 150px 110px auto;gap:0.75rem;align-items:center;">
          <input class="form-control" name="reference" placeholder="Réf (DOC-xxx)" required>
          <input class="form-control" name="titre" placeholder="Titre du document" required>
          <input class="form-control" name="type" placeholder="Type (procédure...)" value="procédure">
          <input class="form-control" name="version" placeholder="Version" value="1.0">
          <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Créer</button>
        </div>
        <textarea class="form-control" name="description" placeholder="Objet / champ d'application" style="margin-top:.75rem;" rows="2"></textarea>
      </form>

      <table class="table">
        <thead>
          <tr>
            <th>Réf. Document</th>
            <th>Titre</th>
            <th>Type</th>
            <th>Version</th>
            <th>Statut</th>
            <th>Rédacteur</th>
          </tr>
        </thead>
        <tbody>
          <% docsList.forEach(d => { %>
            <tr>
              <td style="font-weight:700;font-family:'JetBrains Mono',monospace;">
                <span class="badge-role" style="background:#f1f5f9;color:#0f172a;"><%= d.reference %></span>
              </td>
              <td style="font-weight:600;color:var(--text-main);"><%= d.titre %></td>
              <td><%= d.type %></td>
              <td><span class="badge-role">v<%= d.version %></span></td>
              <td>
                <span class="badge-role" style="background:#ecfdf5;color:#047857;font-weight:700;"><%= d.statut %></span>
              </td>
              <td style="color:var(--text-muted);"><%= d.auteur %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  <% } else if (currentTab === 'risques') { %>
    <div class="card" style="padding:1.5rem;">
      <h2 style="font-size:1.15rem;font-weight:700;margin:0 0 1.25rem;color:var(--text-main);">
        <i class="fas fa-shield-alt" style="color:var(--primary);margin-right:0.4rem;"></i>
        Matrice des Risques &amp; Opportunités R&amp;D
      </h2>
      <form method="POST" action="/management" style="background:var(--bg-subtle);padding:1.25rem;border-radius:var(--radius-md);margin-bottom:1.5rem;border:1px solid var(--border);">
        <% if (locals.sid) { %><input type="hidden" name="sid" value="<%= locals.sid %>"><% } %>
        <input type="hidden" name="action" value="risque">
        <div style="display:grid;grid-template-columns:140px 1fr 100px 100px auto;gap:.75rem;align-items:center;">
          <select name="type" class="form-control" style="font-weight:600;">
            <option value="risque">Risque</option>
            <option value="opportunite">Opportunité</option>
          </select>
          <input class="form-control" name="description" placeholder="Description du risque / opportunité" required>
          <input class="form-control" type="number" min="1" max="5" name="probabilite" value="2" title="Probabilité (1 à 5)">
          <input class="form-control" type="number" min="1" max="5" name="impact" value="3" title="Impact (1 à 5)">
          <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Enregistrer</button>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-top:.75rem;">
          <input class="form-control" name="action_prevue" placeholder="Action préventive / de traitement">
          <input class="form-control" name="responsable" placeholder="Responsable">
        </div>
      </form>

      <table class="table">
        <thead>
          <tr>
            <th>Nature</th>
            <th>Description &amp; Périmètre</th>
            <th style="text-align:center;">Criticité (P×I)</th>
            <th>Action de maîtrise</th>
            <th>Responsable</th>
            <th>Statut</th>
          </tr>
        </thead>
        <tbody>
          <% risksList.forEach(r => { %>
            <tr>
              <td>
                <span class="badge-role" style="<%= r.type === 'opportunite' ? 'background:#ecfdf5;color:#047857;' : 'background:#fef2f2;color:#b91c1c;' %>font-weight:700;">
                  <%= r.type %>
                </span>
              </td>
              <td style="font-weight:600;color:var(--text-main);"><%= r.description %></td>
              <td style="text-align:center;font-weight:800;font-size:1.1rem;color:<%= r.criticite >= 10 ? '#b91c1c' : 'var(--text-main)' %>;">
                <%= r.criticite %>
              </td>
              <td style="color:var(--text-body);"><%= r.action_prevue || '—' %></td>
              <td style="color:var(--text-muted);"><%= r.responsable || '—' %></td>
              <td><span class="badge-role"><%= r.statut %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  <% } else if (currentTab === 'actions') { %>
    <div class="card" style="padding:1.5rem;">
      <h2 style="font-size:1.15rem;font-weight:700;margin:0 0 1.25rem;color:var(--text-main);">
        <i class="fas fa-check-square" style="color:var(--primary);margin-right:0.4rem;"></i>
        Plan d'Actions Qualité &amp; Amélioration Continue
      </h2>
      <form method="POST" action="/management" style="background:var(--bg-subtle);padding:1.25rem;border-radius:var(--radius-md);margin-bottom:1.5rem;border:1px solid var(--border);">
        <% if (locals.sid) { %><input type="hidden" name="sid" value="<%= locals.sid %>"><% } %>
        <input type="hidden" name="action" value="actionq">
        <div style="display:grid;grid-template-columns:1fr 160px 160px auto;gap:.75rem;align-items:center;">
          <input class="form-control" name="description" placeholder="Action d'amélioration à engager" required>
          <input class="form-control" name="responsable" placeholder="Responsable">
          <input class="form-control" type="date" name="echeance">
          <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Ajouter</button>
        </div>
      </form>

      <table class="table">
        <thead>
          <tr>
            <th>Action d'amélioration</th>
            <th>Origine</th>
            <th>Pilote</th>
            <th>Échéance</th>
            <th>Statut</th>
          </tr>
        </thead>
        <tbody>
          <% actionsList.forEach(a => { %>
            <tr>
              <td style="font-weight:600;color:var(--text-main);"><%= a.description %></td>
              <td style="color:var(--text-muted);"><%= a.origine %></td>
              <td style="color:var(--text-body);"><%= a.responsable %></td>
              <td style="color:var(--text-muted);"><%= a.echeance || '—' %></td>
              <td>
                <span class="badge-role" style="background:#eef2ff;color:#4f46e5;font-weight:700;"><%= a.statut %></span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  <% } else if (currentTab === 'nc') { %>
    <div class="card" style="padding:1.5rem;">
      <h2 style="font-size:1.15rem;font-weight:700;margin:0 0 1.25rem;color:var(--text-main);">
        <i class="fas fa-exclamation-triangle" style="color:var(--danger);margin-right:0.4rem;"></i>
        Registre des Non-Conformités &amp; Anomalies
      </h2>
      <form method="POST" action="/management" style="background:var(--bg-subtle);padding:1.25rem;border-radius:var(--radius-md);margin-bottom:1.5rem;border:1px solid var(--border);">
        <% if (locals.sid) { %><input type="hidden" name="sid" value="<%= locals.sid %>"><% } %>
        <input type="hidden" name="action" value="nc">
        <div class="form-group" style="margin-bottom:0.75rem;">
          <input class="form-control" name="description" placeholder="Description précise de l'anomalie ou du défaut constaté" required>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr auto;gap:.75rem;align-items:center;">
          <input class="form-control" name="detection" placeholder="Mode de détection (contrôle réception, banc de test, revue...)">
          <input class="form-control" name="responsable" placeholder="Responsable du traitement">
          <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Déclarer NC</button>
        </div>
      </form>

      <table class="table">
        <thead>
          <tr>
            <th>Réf. NC</th>
            <th>Description de la Non-Conformité</th>
            <th>Détection</th>
            <th>Responsable</th>
            <th>Statut</th>
          </tr>
        </thead>
        <tbody>
          <% ncList.forEach(nc => { %>
            <tr>
              <td style="font-weight:700;font-family:'JetBrains Mono',monospace;">
                <span class="badge-role" style="background:#fef2f2;color:#b91c1c;"><%= nc.reference %></span>
              </td>
              <td style="font-weight:600;color:var(--text-main);"><%= nc.description %></td>
              <td style="color:var(--text-muted);"><%= nc.detection %></td>
              <td style="color:var(--text-body);"><%= nc.responsable %></td>
              <td>
                <span class="badge-role" style="background:#fffbeb;color:#b45309;font-weight:700;"><%= nc.statut %></span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
