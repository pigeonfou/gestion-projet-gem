<%- include('partials/header') %>

<div class="dash-wrap">
  <div class="page-header">
    <h1><i class="fas fa-cog"></i> Paramètres généraux</h1>
  </div>

  <div class="card" style="max-width:700px; margin: 0 auto;">
    <div class="card-body">
      <form method="POST" action="/admin/settings">
        <h3 style="font-size:1.05rem;margin:0 0 1rem;color:#0f172a;border-bottom:1px solid #e2e8f0;padding-bottom:0.5rem;">
          <i class="fas fa-sliders-h"></i> Configuration de l'application
        </h3>

        <div class="form-group">
          <label for="site_nom">Nom de l'application</label>
          <input type="text" id="site_nom" name="site_nom" class="form-control" value="<%= settings.site_nom || 'ProjectFlow' %>" required>
        </div>

        <div class="form-group">
          <label for="site_tagline">Slogan / sous-titre</label>
          <input type="text" id="site_tagline" name="site_tagline" class="form-control" value="<%= settings.site_tagline || '' %>">
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
          <div class="form-group">
            <label for="items_per_page">Éléments par page</label>
            <input type="number" id="items_per_page" name="items_per_page" class="form-control" value="<%= settings.items_per_page || '20' %>">
          </div>
          <div class="form-group">
            <label for="timezone">Fuseau horaire</label>
            <input type="text" id="timezone" name="timezone" class="form-control" value="<%= settings.timezone || 'Europe/Paris' %>">
          </div>
        </div>

        <div class="form-actions" style="display:flex;justify-content:flex-end;margin-top:1.5rem;">
          <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Enregistrer les paramètres</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
