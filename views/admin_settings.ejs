<%- include('partials/header') %>

<div class="dash-wrap">
  <div class="page-header">
    <div>
      <h1><i class="fas fa-cog" style="color:var(--primary);"></i> Paramètres Généraux</h1>
      <p class="subtitle">Configuration globale de l'instance ProjectFlow</p>
    </div>
  </div>

  <div class="card" style="max-width:720px; margin: 0 auto 2.5rem;">
    <div class="card-body" style="padding:2rem;">
      <form method="POST" action="/admin/settings">
        <% if (locals.sid) { %><input type="hidden" name="sid" value="<%= locals.sid %>"><% } %>
        
        <h3 style="font-size:1.1rem;font-weight:700;margin:0 0 1.25rem;color:var(--text-main);border-bottom:1px solid var(--border);padding-bottom:0.75rem;display:flex;align-items:center;gap:0.5rem;">
          <i class="fas fa-sliders-h" style="color:var(--primary);"></i> Identité &amp; Paramètres Système
        </h3>

        <div class="form-group">
          <label for="site_nom">Nom de l'application *</label>
          <input type="text" id="site_nom" name="site_nom" class="form-control" value="<%= settings.site_nom || 'ProjectFlow' %>" required>
        </div>

        <div class="form-group">
          <label for="site_tagline">Slogan institutionnel</label>
          <input type="text" id="site_tagline" name="site_tagline" class="form-control" value="<%= settings.site_tagline || '' %>" placeholder="Ex: Gestion de projets, processus & documentation">
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">
          <div class="form-group">
            <label for="items_per_page">Éléments par page</label>
            <input type="number" id="items_per_page" name="items_per_page" class="form-control" value="<%= settings.items_per_page || '20' %>">
          </div>
          <div class="form-group">
            <label for="timezone">Fuseau horaire système</label>
            <input type="text" id="timezone" name="timezone" class="form-control" value="<%= settings.timezone || 'Europe/Paris' %>">
          </div>
        </div>

        <div class="form-actions" style="display:flex;justify-content:flex-end;margin-top:1.75rem;border-top:1px solid var(--border-light);padding-top:1.25rem;">
          <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Enregistrer les paramètres</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
