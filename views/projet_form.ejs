<%- include('partials/header') %>

<div class="dash-wrap">
  <div class="page-header">
    <h1><i class="fas fa-<%= projet ? 'edit' : 'plus' %>"></i> <%= projet ? 'Modifier le projet' : 'Nouveau projet' %></h1>
    <a href="/projets" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Retour</a>
  </div>

  <div class="card" style="max-width:640px; margin: 0 auto;">
    <div class="card-body">
      <form method="POST" action="/projets<%= projet ? '/modifier' : '/creer' %>">
        <% if (projet) { %>
          <input type="hidden" name="id" value="<%= projet.id %>">
        <% } %>
        
        <div class="form-group">
          <label for="nom">Nom du projet *</label>
          <input type="text" id="nom" name="nom" class="form-control" required value="<%= projet ? projet.nom : '' %>" maxlength="150" placeholder="Ex: Boîtier IoT Industriel V2">
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" class="form-control" rows="4" placeholder="Contexte, finalité et objectifs clés du projet"><%= projet ? projet.description : '' %></textarea>
        </div>

        <fieldset class="form-group" style="border:1px solid #cbd5e1;border-radius:8px;padding:1rem;margin-bottom:1.25rem;">
          <legend style="padding:0 .5rem;font-weight:600;font-size:0.9rem;">Origine de l’entrée et destination de sortie du projet</legend>
          <p style="margin:0 0 .5rem;font-size:0.85rem;color:#475569;"><strong>Direction générale via :</strong></p>
          <label style="display:inline-flex;align-items:center;gap:.4rem;margin-right:1.5rem;font-size:0.875rem;">
            <input type="checkbox" name="cadrage_commerciale" value="1" <%= projet && projet.cadrage_commerciale ? 'checked' : '' %>> Service Commercial
          </label>
          <label style="display:inline-flex;align-items:center;gap:.4rem;font-size:0.875rem;">
            <input type="checkbox" name="cadrage_technique" value="1" <%= projet && projet.cadrage_technique ? 'checked' : '' %>> Service Technique
          </label>
          
          <p style="margin:.85rem 0 .5rem;font-size:0.85rem;color:#475569;"><strong>Destination du besoin :</strong></p>
          <label style="display:inline-flex;align-items:center;gap:.4rem;margin-right:1.5rem;font-size:0.875rem;">
            <input type="radio" name="cadrage_destination" value="interne" <%= (!projet || projet.cadrage_destination === 'interne') ? 'checked' : '' %>> Interne
          </label>
          <label style="display:inline-flex;align-items:center;gap:.4rem;font-size:0.875rem;">
            <input type="radio" name="cadrage_destination" value="externe" <%= (projet && projet.cadrage_destination === 'externe') ? 'checked' : '' %>> Externe (client)
          </label>
        </fieldset>

        <div class="form-actions" style="display:flex;gap:.75rem;justify-content:flex-end;">
          <a href="/projets" class="btn btn-secondary">Annuler</a>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Enregistrer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
