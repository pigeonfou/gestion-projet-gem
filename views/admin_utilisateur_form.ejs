<%- include('partials/header') %>

<div class="dash-wrap">
  <div class="page-header">
    <h1><i class="fas fa-<%= targetUser ? 'user-edit' : 'user-plus' %>"></i> <%= targetUser ? 'Modifier l’utilisateur' : 'Nouvel utilisateur' %></h1>
    <a href="/admin/utilisateurs" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Retour</a>
  </div>

  <div class="card" style="max-width:600px; margin: 0 auto;">
    <div class="card-body">
      <form method="POST" action="/admin/utilisateurs<%= targetUser ? '/modifier' : '/creer' %>">
        <% if (targetUser) { %>
          <input type="hidden" name="id" value="<%= targetUser.id %>">
        <% } %>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
          <div class="form-group">
            <label for="identifiant">Identifiant de connexion *</label>
            <input type="text" id="identifiant" name="identifiant" class="form-control" required value="<%= targetUser ? targetUser.identifiant : '' %>" placeholder="Ex: jean.dupont">
          </div>
          <div class="form-group">
            <label for="role">Rôle dans l'application *</label>
            <select id="role" name="role" class="form-control" required>
              <option value="utilisateur" <%= !targetUser || targetUser.role === 'utilisateur' ? 'selected' : '' %>>Utilisateur</option>
              <option value="admin" <%= targetUser && targetUser.role === 'admin' ? 'selected' : '' %>>Administrateur</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="mot_de_passe">Mot de passe <%= targetUser ? '(laisser vide pour ne pas modifier)' : '*' %></label>
          <input type="password" id="mot_de_passe" name="mot_de_passe" class="form-control" <%= targetUser ? '' : 'required' %> placeholder="Mot de passe">
        </div>

        <div class="form-group">
          <label for="nom_affiche">Nom &amp; prénom affichés</label>
          <input type="text" id="nom_affiche" name="nom_affiche" class="form-control" value="<%= targetUser ? targetUser.nom_affiche : '' %>" placeholder="Ex: Jean Dupont">
        </div>

        <div class="form-group">
          <label for="fonction">Fonction / titre de poste</label>
          <input type="text" id="fonction" name="fonction" class="form-control" value="<%= targetUser ? targetUser.fonction : '' %>" placeholder="Ex: Ingénieur Conception R&D">
        </div>

        <div class="form-group">
          <label for="competences">Compétences techniques &amp; qualifications</label>
          <textarea id="competences" name="competences" class="form-control" rows="3" placeholder="CAO, Firmware, ISO 9001, etc."><%= targetUser ? targetUser.competences : '' %></textarea>
        </div>

        <div class="form-actions" style="display:flex;gap:.75rem;justify-content:flex-end;">
          <a href="/admin/utilisateurs" class="btn btn-secondary">Annuler</a>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Enregistrer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
